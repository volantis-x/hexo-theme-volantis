<%# 侧边栏组件控制 _%>
<%_
let widget_style_list = [];

let pf = [];
if (item.display) {
  getList(item.display).forEach(function(p){
    pf.push(p);
  });
} else {
  pf = ['desktop', 'mobile'];
}
widget_style_list.push(...pf);
page.widget_platform = pf.join(' ');

let widget_style = [];
if (where == 'sidebar') {
  widget_style = theme.custom_css.sidebar.effect;
} else if (where == 'body') {
  widget_style = theme.custom_css.body.effect;
}
widget_style_list.push(...widget_style);
page.widget_style = widget_style.join(' ');

if (item.sticky === true  || item.pjaxReload === false){
  page.widget_pjax = "";
} else {
  page.widget_pjax = "pjax";
  widget_style_list.push("pjax");
}


page.widget_style_list = widget_style_list.join(' ');
_%>
