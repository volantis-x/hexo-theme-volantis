<%- partial('_pre') %>
<% page.comments = false; %>
<%
function layout_topic_list(partial) {
  var el = ''
  const { publish_list, tree } = theme.topic
  for (let id of publish_list) {
    const topic = tree[id]
    if (topic == null) {
      continue
    }
    el += `<div class='post-wrapper'>`
    el += partial(topic)
    el += `</div>`
  }
  return el
}
function layoutDiv() {
  var el = ''
  el += layout_topic_list(function(topic) {
    return partial('_partial/post', {post: topic, index: false})
  })
  return el
}
%>
<div id="l_main" class='<%- page.sidebar == false ? ' no_sidebar' : '' %>'>
    <section class="post-list">
        <%- layoutDiv() %>
    </section>
</div>
<%- partial('_partial/side') %>
