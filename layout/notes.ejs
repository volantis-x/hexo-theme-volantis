<%# 笔记列表页主体部分 %>
<%- partial('_pre') %>
<% page.comments = false; %>
<div id="l_main" class='<%- page.sidebar == false ? ' no_sidebar' : '' %>'>
<section class="post-list post">
  <% page.posts.each(post => { %>
    <a href="<%= pretty_url(post.link || post.path) %><%= page.activeTag ? `?tag=${page.activeTag}` : '' %>">
      <%- include('_partial/card_list/note_card', { note: post }) %>
    </a>
  <% }) %>
</section>
</div>
<%- partial('_partial/side') %>
