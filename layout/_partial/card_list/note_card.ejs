<%
/**
 * 笔记预览卡片模板
 * 用于Hexo博客主题，用于渲染笔记列表中的单篇文章预览
 */
const post = note;
post.headimg = note.cover

// 计算是否显示置顶图标：需同时满足文章置顶、存在标题（或自动生成标题）、主题启用置顶图标
const showPin = post.pin && (post.title || theme.article.preview.auto_title) && theme.article.preview.pin_icon;


// 计算是否显示标签：存在标签且数量大于0
const showTags = post.tags && post.tags.length > 0;




// 确定文章标题：优先使用post.title或post.seo_title，都不存在则用日期作为标题
const articleTitle = (post.title || post.seo_title) || 
                    date(post.date, theme.article.body.meta_library.date.format);



const coverPosition =  (()=>{
  if (post.topicline) {
    return "top";
  }
  return "bottom";
})();


// CSS类名集中管理，便于统一修改样式
const classes = {
  container: `post post-v3 white-box reveal ${theme.custom_css.body.effect.join(' ')}`,
  headimg: `headimg-div ${post?.imgcover ? 'headimg-cover' : ''}`,
  title: 'article-title',
  description: 'md article-desc',
  meta: 'meta-v3'
};
%>

<!-- 文章预览卡片容器，使用schema.org的Article类型进行结构化数据标记 -->
<div class="<%= classes.container %>" itemscope itemtype="http://schema.org/Article">
  <!-- 标记文章的主要页面链接 -->
  <link itemprop="mainEntityOfPage" href="<%- decodeURI(post.permalink) %>">
  
  <!-- 隐藏的发布者信息，使用schema.org的Organization类型 -->
  <span hidden itemprop="publisher" itemscope itemtype="http://schema.org/Organization">
    <meta itemprop="name" content="<%- escape_html(strip_html(config.title)) %>">
  </span>
  <span hidden itemprop="post" itemscope itemtype="http://schema.org/CreativeWork">
    <meta itemprop="name" content="<%- escape_html(strip_html(post.title || post.seo_title || config.title)) %>">
    <meta itemprop="description" content="<%- escape_html(strip_html(post.description || config.description)) %>">
  </span>

  <!-- 显示置顶图标（如果计算得出需要显示） -->
  <% if (showPin) { %>
    <div class='pin'>
      <img alt="<%- escape_html(post.title) %>" src='<%- theme.article.preview.pin_icon %>'/>
    </div>
  <% } %>
  
  <!-- 显示文章头图（如果存在） -->
  <% if (post.headimg) { %>
    <div class='<%= classes.headimg %>' position="<%- coverPosition %>">
        <img itemprop="image" class='headimg' alt="<%- escape_html(articleTitle) %>" src='<%- post.headimg %>'/>
        <% if (post.headimg && post.imgcover) { %>
          <div class="cover-info" position="<%- coverPosition %>">
            <% if (post.topicline) { %>
              <div class="text topicline"><%- post.topicline %></div>
            <% } %>
            <% if (showTitle) { %>
              <div class="text headline"><%- articleTitle %></div>
            <% } else { %>
              <span hidden itemprop="name headline"><%- articleTitle %></span>
            <% } %>
            <div class="text caption">
              <% if (post.excerpt) { %>
              <!-- 显示文章摘要 -->
                <%- post.excerpt %>
              <% } else if (post.description) { %>
                <!-- 若没有摘要则显示描述 -->
                <%- post.description %>
              <% } else if (post.content) { %>
                <!-- 若既没有摘要也没有描述，则使用文章内容 -->
                <% if (theme.article.preview.auto_excerpt) { %>
                  <!-- 主题启用自动摘要时，显示截断后的内容（200字符） -->
                  <%- truncate(strip_html(post.content), {length: 200}) %>
                <% } else if (!theme.article.preview.hide_excerpt) { %>
                  <!-- 未禁用摘要显示时，显示完整内容 -->
                  <%- post.content %>
                <% } %>
              <% } %>
            </div>
          </div>
        <% } %>
    </div>
  <% } else { %>
    <!-- 如果没有头图，使用主题配置的默认图片作为结构化数据 -->
    <span hidden>
      <meta itemprop="image" content="<%- theme.structured_data.data.logo.path %>">
    </span>
  <% } %>

  <!-- 一般场景 -->
  <% if (!(post.headimg && post.imgcover)) { %>
    <!-- 文章标题区域，使用schema.org的name和headline属性 -->

      <h2 class="<%= classes.title %>" itemprop="name headline">
          <%- articleTitle %>
      </h2>

    <!-- 文章摘要/描述区域，使用schema.org的articleBody属性 -->
    <div class="<%= classes.description %>" itemprop="articleBody">
      <% if (post.excerpt) { %>
        <!-- 显示文章摘要 -->
        <%- post.excerpt %>
      <% } else if (post.description) { %>
        <!-- 若没有摘要则显示描述 -->
        <p><%- post.description %></p>
      <% } else if (post.content) { %>
        <!-- 若既没有摘要也没有描述，则使用文章内容 -->
        <% if (theme.article.preview.auto_excerpt) { %>
          <!-- 主题启用自动摘要时，显示截断后的内容（200字符） -->
          <%- truncate(strip_html(post.content), {length: 200}) %>
        <% } else if (!theme.article.preview.hide_excerpt) { %>
          <!-- 未禁用摘要显示时，显示完整内容 -->
          <%- post.content %>
        <% } %>
      <% } %>
    </div>
    
    <!-- 元信息区域（日期、标签） -->
    
      <div class="<%= classes.meta %>" line_style='<%- theme.article.preview.line_style %>'>
        <div>

          
          <!-- 显示文章更新时间，使用schema.org的dateModified属性 -->
          <time class="update-time" itemprop="dateModified" 
                datetime="<%- moment(post.updated).format() %>" 
                title="<%- date(post.updated, theme.article.body.meta_library.updated.format) %>">
            <%= date(post.updated, config.date_format) %>
          </time>
          
          
          <!-- 显示文章标签（如果需要显示） -->
          <% if (showTags) { %>
          <% post.tags.forEach((tag, i) => { %>
            <span class="dot"></span>
            <span class="tag"><%= tag %></span>
          <% }) %>
            
            <!-- 标签的结构化数据 -->
            <% post.tags.toArray().forEach(tag => { %>
              <span hidden itemprop="about" itemscope itemtype="http://schema.org/Thing">
                <a href="<%- url_for(tag.path) %>" itemprop="url"><span itemprop="name"><%- tag.name %></span></a>
              </span>
            <% }) %>
          <% } %>
        </div>
        

      </div>
    
  <% } %>
</div>
