    <%- partial('header', {item: item}) %>
    <div class='content'>
      <%- partial('../_plugins/aplayer/layout', {post: null, where: 'widget'}) %>
    </div>
  </section>
<% }else{ %>
  <div class="<%- page.widget_pjax %>">
    <!-- pjax占位 music-->
  </div>
<% } %>
