// 链接卡片标签样式（link tag plugin）
// v5
.md .tag.link
  margin-top: $gap-p
  margin-bottom: $gap-p
// 链接卡片主体：左图标 + 右文字的横向布局
.md .link-card
  margin-right: $gap-p
  background: var(--color-block)
  display: inline-flex
  align-items: center
  cursor: pointer
  text-align: center
  width: $device-mobile-l - 4 * $gap
  max-width: 100%
  box-shadow: $boxshadow-card
  @media screen and (max-width: $device-mobile-l)
    max-width: 100%
    width: 100%
  color: var(--color-p)
  border-radius: $border-card
  &:hover
    box-shadow: $boxshadow-float, $boxshadow-card-float

// 链接卡片内部布局：左侧图标区 + 右侧文字区
.md .link-card
  div.left,div.right
    pointer-events: none
  div.left
    width: 54px
    height: 54px
    margin: 12px
    overflow: hidden
    flex-shrink: 0
    position: relative
    i
      font-size: 32px
      line-height: 48px
      margin-left: 4px
    img
      display: block
      position: absolute
      border-radius: $border-card / 4
      top: 50%
      left: 50%
      transform: translate(-50%, -50%)
  div.right
    overflow: hidden
    margin-right: 16px
  p
    margin: 0
    txt-ellipsis()
  p.text
    font-weight: bold
  p.url
    flex-shrink: 0
    color: var(--color-meta)
    font-size: $fontsize-code
// 链接卡片分组：双列网格布局，移动端单列
.md .link-group
  display: grid
  grid-template-columns: 1fr 1fr
  @media screen and (max-width: $device-mobile-l * 2)
    grid-template-columns: 1fr
  grid-gap: $gap
  .tag.link
    margin: 0
  .link-card
    width: 100%
// v6
.md .tag-plugin.link
  margin: 1em auto
  display: flex
  justify-content: center
  text-align: left

.md .tag-plugin .link-card
  background: var(--card)
  display: inline-flex
  justify-content: space-between
  align-items: center
  cursor: pointer
  width: 300px
  max-width: 100%
  border-radius: $border-card-s
  corner-shape: superellipse(1.2)
  hoverable-card()

.md .tag-plugin .link-card.plain
  flex-direction: row
  align-items: center

.md .tag-plugin .link-card.rich
  flex-direction: column
  align-items: stretch
  width: 460px
  text-align: justify

.md .tag-plugin .link-card
  >.left
    width: unset
    height: unset
    overflow: hidden
    margin: 0.75rem 0 0.75rem 0.75rem
    .title
      font-size: $fs-14
    span+span 
      margin-top: 0.25rem
  >.right
    width: 2.75rem
    height: 2.75rem
    margin: 0.75rem
    overflow: hidden
    flex-shrink: 0
    .img
      line-height: 0
      height: 44px
      width: 44px
      border-radius: 16px
      background-repeat: no-repeat
      background-size: contain
      background-position: left center
  >.top
    display: flex
    margin: 1rem 1rem 0.75rem
    overflow: hidden
    max-width: 'calc(100% - %s * 2)' % 1rem
    align-items: center
    .img
      line-height: 0
      height: 16px
      width: 16px
      border-radius: 16px
      margin-right: 8px
      background-repeat: no-repeat
      background-size: contain
      background-position: left center
    span
      txt-ellipsis()
      max-width: 100%
  >.bottom
    margin: 0 1rem 1rem
    .title
      font-size: 1rem
      margin-bottom: 0.5rem

.md .tag-plugin .link-card
  line-height: 1.2
  .title
    display: -webkit-box
    -webkit-box-orient: vertical
    overflow: hidden
    -webkit-line-clamp: 2
  .cap
    flex-shrink: 0
    color: var(--text-p3)
  .link
    line-height: 1.5
    opacity: .75
    txt-ellipsis()
  .desc
    display: -webkit-box
    -webkit-box-orient: vertical
    overflow: hidden
    -webkit-line-clamp: 3
  .img
    border-radius: 4px

  span
    margin: 0
    display: block
  .title
    font-weight: 500
    color: var(--text-p1)

