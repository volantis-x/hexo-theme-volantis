// 行内文本装饰样式（删除线/下划线/着重号/波浪线/密码/kbd）

.article
  // 删除线：降低文字和线条颜色对比度
  del
    color: var(--text-p3)
    text-decoration: line-through var(--text-p3)
  // 下划线：红色实线下划线
  u
    color: var(--color-text)
    text-decoration: none
    border-bottom: 2px solid var(--accent)
  // 着重号：红色点状底线
  emp
    color: var(--color-text)
    width: fit-content
    text-decoration: none
    border-bottom: 4px dotted var(--accent)
  // 波浪线：红色波浪下划线
  wavy
    color: var(--color-text)
    text-decoration: underline wavy var(--accent)
  // 密码遮罩：默认透明，悬停显示
  psw
    color: transparent
    background: #a1a1a1
    border-radius: 2px
    trans1 background
    margin: auto 2px
    &:hover
      color: inherit
      background: none
  // 键盘按键：类 macOS 风格的立体阴影效果
  kbd
    border-radius: 4px
    border: 1px solid #d2d2d2
    border-bottom-width: 2px
    background: var(--card)
    padding: 2px 4px 1px 4px
    font-family: $ff-code
    font-weight: 700
  // 高斯模糊
  blur
    filter: blur(4px)
    trans1 all
    &:hover
      filter: blur(0)
  // 上角标 下角标
  sup,sub
    color: var(--theme)
    line-height: 1
    font-weight: 700
    font-family: $ff-code
  h1,h2,h3,h4
    sup,sub
      font-size: .85rem
